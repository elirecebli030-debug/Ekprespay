# Bütün faylları blokla
Order Deny,Allow
Deny from all

# Yalnız POST icazəsi
<Files "telegram-handler.php">
    <Limit POST>
        Order Allow,Deny
        Allow from all
    </Limit>
</Files>

# PHP fayllarını gizlət
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Konfiq fayllarını blokla
<FilesMatch "\.(htaccess|htpasswd|ini|log|txt|json|xml|config)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

php_flag display_errors off
php_flag display_startup_errors off
php_value error_reporting 0
Options -Indexes
