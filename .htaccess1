# 🔥 API QOVLUĞU ÜÇÜN TAM İCAZƏ

# PHP fayllarına icazə ver
<Files "telegram-handler.php">
    Order Allow,Deny
    Allow from all
</Files>

# Digər faylları blokla
<FilesMatch "\.(htaccess|htpasswd|ini|log|txt|json|xml|config)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Xətaları gizlət
php_flag display_errors off
php_flag display_startup_errors off
php_value error_reporting 0

# İndeksləməni söndür
Options -Indexes
